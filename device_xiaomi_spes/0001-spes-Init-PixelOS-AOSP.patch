From e4cc0bbcf8e61f06e6b2721471283cb544b7bdcb Mon Sep 17 00:00:00 2001
From: Angaddeep Singh <angxddeep@gmail.com>
Date: Sat, 4 Jan 2025 16:16:03 -0300
Subject: [PATCH] spes: Init @PixelOS-AOSP

Change-Id: I0e22546a3e2fc8d0c92b2eda820820a3d80c0180
---
 AndroidProducts.mk                              |  7 +------
 lineage_spes.mk => custom_spes.mk               | 17 ++++++++++-------
 device.mk                                       |  3 ++-
 overlay/UpdaterOverlaySpes/Android.bp           | 10 ++++++++++
 overlay/UpdaterOverlaySpes/AndroidManifest.xml  | 14 ++++++++++++++
 .../UpdaterOverlaySpes/res/values/strings.xml   | 11 +++++++++++
 6 files changed, 48 insertions(+), 14 deletions(-)
 rename lineage_spes.mk => custom_spes.mk (79%)
 create mode 100644 overlay/UpdaterOverlaySpes/Android.bp
 create mode 100644 overlay/UpdaterOverlaySpes/AndroidManifest.xml
 create mode 100644 overlay/UpdaterOverlaySpes/res/values/strings.xml

diff --git a/AndroidProducts.mk b/AndroidProducts.mk
index 1028a70..5ef13d3 100644
--- a/AndroidProducts.mk
+++ b/AndroidProducts.mk
@@ -5,9 +5,4 @@
 #
 
 PRODUCT_MAKEFILES := \
-    $(LOCAL_DIR)/lineage_spes.mk
-
-COMMON_LUNCH_CHOICES := \
-    lineage_spes-user \
-    lineage_spes-userdebug \
-    lineage_spes-eng
+    $(LOCAL_DIR)/custom_spes.mk
diff --git a/lineage_spes.mk b/custom_spes.mk
similarity index 79%
rename from lineage_spes.mk
rename to custom_spes.mk
index b0c8fd8..a246035 100644
--- a/lineage_spes.mk
+++ b/custom_spes.mk
@@ -11,13 +11,11 @@ $(call inherit-product, $(SRC_TARGET_DIR)/product/full_base_telephony.mk)
 # Inherit from spes/spesn device
 $(call inherit-product, device/xiaomi/spes/device.mk)
 
-# Inherit some common LineageOS stuff.
-$(call inherit-product, vendor/lineage/config/common_full_phone.mk)
-TARGET_SCREEN_HEIGHT := 2400
-TARGET_SCREEN_WIDTH := 1080
+# Inherit some common PixelOS stuff.
+$(call inherit-product, vendor/custom/config/common_full_phone.mk)
 
 # Product Specifics
-PRODUCT_NAME := lineage_spes
+PRODUCT_NAME := custom_spes
 PRODUCT_DEVICE := spes
 PRODUCT_BRAND := Redmi
 PRODUCT_MODEL := Redmi Note 11
@@ -25,8 +23,13 @@ PRODUCT_MANUFACTURER := Xiaomi
 
 PRODUCT_GMS_CLIENTID_BASE := android-xiaomi
 
-# Overlay
-DEVICE_PACKAGE_OVERLAYS += $(LOCAL_PATH)/overlay-lineage
+# For Erofs / GMS
+WITH_GMS := true
+
+# Boot animaton
+TARGET_BOOT_ANIMATION_RES := 1080
+TARGET_SCREEN_HEIGHT := 2400
+TARGET_SCREEN_WIDTH := 1080
 
 # Fingerprint
 PRODUCT_BUILD_PROP_OVERRIDES += \
diff --git a/device.mk b/device.mk
index 8a08b9d..8c5eac8 100644
--- a/device.mk
+++ b/device.mk
@@ -330,7 +330,8 @@ PRODUCT_PACKAGES += \
     SpesSystemUIOverlay \
     SpesTelephonyOverlay \
     SpesWifiOverlay \
-    NcmTetheringOverlay
+    NcmTetheringOverlay \
+    SpesUpdaterOverlay
 
 # Partitions
 PRODUCT_PACKAGES += \
diff --git a/overlay/UpdaterOverlaySpes/Android.bp b/overlay/UpdaterOverlaySpes/Android.bp
new file mode 100644
index 0000000..7ae85b6
--- /dev/null
+++ b/overlay/UpdaterOverlaySpes/Android.bp
@@ -0,0 +1,10 @@
+//
+// Copyright (C) 2026 The PixelOS Project
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+
+runtime_resource_overlay {
+    name: "SpesUpdaterOverlay",
+    product_specific: true,
+}
diff --git a/overlay/UpdaterOverlaySpes/AndroidManifest.xml b/overlay/UpdaterOverlaySpes/AndroidManifest.xml
new file mode 100644
index 0000000..5fdd636
--- /dev/null
+++ b/overlay/UpdaterOverlaySpes/AndroidManifest.xml
@@ -0,0 +1,14 @@
+<?xml version="1.0" encoding="utf-8" ?>
+<!--
+     SPDX-License-Identifier: Apache-2.0
+-->
+<manifest
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    package="net.pixelos.ota.overlay.spes"
+>
+    <overlay
+        android:isStatic="true"
+        android:priority="1"
+        android:targetPackage="net.pixelos.ota"
+    />
+</manifest>
diff --git a/overlay/UpdaterOverlaySpes/res/values/strings.xml b/overlay/UpdaterOverlaySpes/res/values/strings.xml
new file mode 100644
index 0000000..92337e5
--- /dev/null
+++ b/overlay/UpdaterOverlaySpes/res/values/strings.xml
@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="utf-8" ?>
+<resources>
+    <string
+        name="updater_server_url"
+        translatable="false"
+    >https://raw.githubusercontent.com/Angxddeep/PIXELOS-OTA/refs/heads/spes/updates_new.json</string>
+    <string
+        name="changelog_url"
+        translatable="false"
+    >https://raw.githubusercontent.com/Angxddeep/PIXELOS-OTA/refs/heads/spes/spes.md</string>
+</resources>
-- 
